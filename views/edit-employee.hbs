<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit {{employee.name}}</title>
    <style>
        body   { font-family: sans-serif; max-width: 400px; margin: 40px auto; }
        label  { display: block; margin-top: 12px; }
        input  { width: 100%; padding: 6px; margin-top: 4px; box-sizing: border-box; }
        button { margin-top: 16px; padding: 8px 20px; }
        a      { display: block; margin-top: 12px; color: #0066cc; }
    </style>
</head>
<body>
    <h2>Edit Employee</h2>
    <form method="POST" action="/edit/{{employee._id}}">
        <label>Name
            <input type="text" name="name" value="{{employee.name}}" required>
        </label>
        <label>Phone (format: 1234-5678)
            <input type="text" name="phone" value="{{employee.phone}}" required>
        </label>
        <button type="submit">Save</button>
    </form>
    <a href="/">← Cancel</a>
</body>
</html>