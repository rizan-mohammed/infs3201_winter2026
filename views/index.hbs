<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Employee Scheduling System</title>
</head>
<body>
    <h1>Employees</h1>
    <a href="/logout">Logout</a>

    {{#if employees.length}}
        <ul>
            {{#each employees}}
                <li><a href="/employee/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    {{else}}
        <p>No employees found.</p>
    {{/if}}

    <a href="/employee/add">Add New Employee</a>
</body>
</html>