<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{employee.name}} - Details</title>
    <style>
        .morning { background-color: yellow; }
    </style>
</head>
<body>
    <h1>{{employee.name}}</h1>

    {{#if employee.photo}}
        <img src="/uploads/{{employee.photo}}" alt="{{employee.name}}" width="150"><br><br>
    {{/if}}

    <p><strong>Phone:</strong> {{employee.phone}}</p>
    <a href="/employee/{{employee._id}}/edit">Edit Details</a>

    <h2>Shifts</h2>
    {{#if shifts.length}}
        <table border="1">
            <thead>
                <tr><th>Date</th><th>Start Time</th><th>End Time</th></tr>
            </thead>
            <tbody>
                {{#each shifts}}
                    <tr>
                        <td>{{this.date}}</td>
                        <td {{#if this.isMorning}}class="morning"{{/if}}>{{this.startTime}}</td>
                        <td>{{this.endTime}}</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p>No shifts assigned.</p>
    {{/if}}

    <a href="/">Back to Employee List</a>
</body>
</html>